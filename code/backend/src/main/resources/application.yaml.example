spring:
  application:
    name: backend

  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

  datasource:
    url: jdbc:postgresql://localhost:5432/dev_track_ai?options=-c%20timezone=Asia/Ho_Chi_Minh
    username: postgres
    password: YOUR_DATABASE_PASSWORD_HERE # 👈 Điền mật khẩu database PostgreSQL local của bạn vào đây
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        jdbc:
          lob:
            non_contextual_creation: true
    open-in-view: false

  flyway:
    enabled: true
    out-of-order: true
    baseline-on-migrate: true
    locations: classpath:db/migration

  # Redis - dùng cho OTP, Session, Cache
  # Đảm bảo Redis đang chạy trước khi khởi động backend (redis-server)
  data:
    redis:
      host: localhost
      port: 6379 # Port mặc định của Redis
    mongodb:
      uri: mongodb://localhost:27017/dev_track_ai

  session:
    store-type: redis
    timeout: 30m # Session hết hạn sau 30 phút

  kafka:
    bootstrap-servers: localhost:9092
    producer:
      key-serializer: org.apache.kafka.common.serialization.StringSerializer
      value-serializer: org.apache.kafka.common.serialization.StringSerializer

  mail:
    host: smtp.gmail.com
    port: 587
    username: email_cua_ban@gmail.com # 👈 Điền Gmail thật của bạn vào đây để gửi email OTP
    password: mat_khau_ung_dung_16_ky_tu # 👈 Điền App Password 16 ký tự (không phải mật khẩu Gmail thường)
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000

cloudinary:
  cloud-name: "YOUR_CLOUD_NAME_HERE"
  api-key: "YOUR_API_KEY_HERE"
  api-secret: "YOUR_API_SECRET_HERE"

# GitHub OAuth & Integration Settings
github:
  client-id: "YOUR_GITHUB_OAUTH_CLIENT_ID"
  client-secret: "YOUR_GITHUB_OAUTH_CLIENT_SECRET"
  redirect-uri: "http://localhost:5173/github/callback"
  webhook-url: "YOUR_NGROK_PUBLIC_URL_HERE/api/v1/github/webhook" # 👈 Điền link Ngrok public để nhận webhook từ GitHub local (ví dụ: https://xxxx.ngrok-free.dev/api/v1/github/webhook)
  encryption:
    # 👈 Mật khẩu dùng để mã hóa (AES key). PHẢI đúng 16, 24, hoặc 32 ký tự.
    # Bạn CẦN TẠO 1 chuỗi ngẫu nhiên (ví dụ: DevTrackSecKey123456789012345678)
    key: "YOUR_16_24_32_CHAR_SECRET_KEY_HERE"

app:
  events:
    # local = team members can run without Kafka; kafka = publish outbox events to Kafka topics
    publisher: local
    outbox-publish-delay-ms: 30000

code-insight:
  ai:
    # gemini = real Gemini provider. AI Review returns provider errors when the API cannot produce a review.
    provider: ${CODE_INSIGHT_AI_PROVIDER:gemini}
    api-key: ${CODE_INSIGHT_AI_API_KEY:}
    model: ${CODE_INSIGHT_AI_MODEL:gemini-2.5-flash}
    timeout-seconds: ${CODE_INSIGHT_AI_TIMEOUT_SECONDS:30}
