spring:
  application:
    name: backend

  datasource:
    url: jdbc:postgresql://localhost:5432/dev_track_ai
    username: postgres
    password: YOUR_DATABASE_PASSWORD_HERE # 👈 Điền mật khẩu database PostgreSQL local của bạn vào đây
    driver-class-name: org.postgresql.Driver

  flyway:
    enabled: true
    out-of-order: true

  mail:
    host: smtp.gmail.com
    port: 587
    username: email_cua_ban@gmail.com # 👈 Điền Gmail thật của bạn vào đây để gửi email
    password: mat_khau_ung_dung_16_ky_tu # 👈 Điền mật khẩu ứng dụng 16 ký tự của bạn vào đây
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
            required: true
          connectiontimeout: 5000
          timeout: 5000
          writetimeout: 5000
