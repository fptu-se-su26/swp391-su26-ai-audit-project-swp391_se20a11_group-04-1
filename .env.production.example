POSTGRES_DB=dev_track_ai
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=replace_with_strong_password
MONGODB_DATABASE=devtrack_ai

HTTP_PORT=80
PUBLIC_BASE_URL=https://your-domain.example
APP_BASE_URL=https://your-domain.example
APP_CORS_ALLOWED_ORIGINS=https://your-domain.example
APP_MONITORING_ADMIN_EMAIL=admin@your-domain.example

INTERNAL_SERVICE_KEY=replace_with_long_random_internal_key

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=replace_with_app_password

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

GEMINI_API_KEY=replace_me
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
OPENROUTER_API_KEYS=disabled
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-3.6-flash
OPENROUTER_MAX_TOKENS=16384
GROQ_API_KEYS=replace_me
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8192

# Ollama endpoint reachable from the ml-service Docker container.
# Leave this value when Ollama runs on the same server; otherwise use the AI server IP/domain.
OLLAMA_BASE_URL=http://host.docker.internal:11434

GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
GITHUB_REDIRECT_URI=https://your-domain.example/github/callback
GITHUB_WEBHOOK_URL=https://your-domain.example/api/v1/github/webhook
GITHUB_ENCRYPTION_KEY=replace_with_32_char_key

VITE_WS_URL=wss://your-domain.example/api/ws
VITE_GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=replace_me

MAX_CONCURRENT_RUNS=3
PARSE_TIMEOUT_SECONDS=300
