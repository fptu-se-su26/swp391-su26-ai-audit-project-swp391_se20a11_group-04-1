# ─── DATABASE ───────────────────────────────
POSTGRES_DB=dev_track_ai
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=changeme_strong_password

# ─── REDIS ──────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── KAFKA ──────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BROKERS=kafka:9092

# ─── EVENT PUBLISHER ────────────────────────
# local = chạy không cần Kafka (dev nhanh); kafka = gửi job thật lên Kafka (VPS/production)
APP_EVENTS_PUBLISHER=kafka

# ─── BACKEND ────────────────────────────────
SPRING_PROFILES_ACTIVE=docker
DB_HOST=postgres
DB_PORT=5432
API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:5173

# ─── INTERNAL SERVICE ───────────────────────
INTERNAL_SERVICE_KEY=changeme_internal_key_32chars

# ─── PLAYWRIGHT SERVICE ──────────────────────
PLAYWRIGHT_SERVICE_URL=http://playwright-server:4001
WS_URL=ws://playwright-server:4001
BACKEND_URL=http://backend:8080
PORT=4001
MAX_CONCURRENT_RUNS=3

# ─── ARCHITECTURE PARSER SERVICE ─────────────
ARCHITECTURE_PARSER_URL=http://architecture-parser:4002

# ─── FRONTEND ────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:4001

# ─── GITHUB OAUTH ────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/github/callback
GITHUB_ENCRYPTION_KEY=16_char_aes_key_here

# ─── CLOUDINARY ──────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── EMAIL (GMAIL) ───────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ─── AI KEYS ────────────────────────────────
GEMINI_API_KEY=key1,key2,key3
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── FRONTEND FIREBASE / GOOGLE ────────────────
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_FIREBASE_API_KEY=your-api-key

# ─── CODE INSIGHT AI ───────────────────────────
CODE_INSIGHT_AI_MODEL=gemini-2.5-flash
CODE_INSIGHT_AI_API_KEY=your_gemini_api_key
CODE_INSIGHT_AI_TIMEOUT_SECONDS=30
CODE_INSIGHT_AI_PROVIDER=gemini

# ─── REDIS LOCK PREFIX ─────────────────────────
APP_REDIS_LOCK_CLASSROOM_JOIN_PREFIX=lock:classroom_join:

# ─── CLASSROOM INVITE ──────────────────────────
APP_CLASSROOM_INVITE_SECRET=changeme_invite_secret
